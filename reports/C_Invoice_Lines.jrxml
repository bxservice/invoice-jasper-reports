	<queryString language="SQL">
		<![CDATA[SELECT
    ilt.line,
    ilt.linenetamt,
    ilt.qtyinvoiced,
    ilt.qtyentered,
    ilt.uomsymbol,
    ilt.c_uom_name,
    COALESCE(pt.Name, ilt.name) AS name,
    COALESCE(pt.Description, ilt.description) AS description,
    ilt.documentnote,
    ilt.productvalue,
    ilt.priceentered,
    ilt.priceactual,
    ilt.productdescription,
    ilt.m_product_id,
    ilt.paymentrule,
    ilt.c_invoice_id AS record_id,
    COALESCE(pt.Description, p.description) AS p_description
FROM c_invoice_linetax_v ilt
JOIN M_Product p
    ON p.M_Product_ID = ilt.M_Product_ID
LEFT JOIN M_Product_Trl pt
    ON pt.M_Product_ID = p.M_Product_ID AND pt.AD_Language = $P{CURRENT_LANG}
WHERE ilt.c_invoice_id = $P{RECORD_ID}
ORDER BY ilt.line]]>
	</queryString>
