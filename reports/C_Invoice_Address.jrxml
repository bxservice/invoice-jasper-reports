	<template><![CDATA["styles.jrtx"]]></template>
	<parameter name="RECORD_ID" class="java.lang.Integer" isForPrompting="false">
		<defaultValueExpression><![CDATA[109]]></defaultValueExpression>
	</parameter>
	<parameter name="CURRENT_LANG" class="java.lang.String" isForPrompting="false">
		<parameterDescription><![CDATA[]]></parameterDescription>
		<defaultValueExpression><![CDATA["de_DE"]]></defaultValueExpression>
	</parameter>
	<parameter name="P_MsgHelper" class="java.lang.Object" isForPrompting="false"/>
	<queryString language="SQL">
		<![CDATA[SELECT
    ih.documentno,
    ih.bpgreeting,
    ih.name,
    ih.name2,
    ih.bpcontactgreeting,
    ih.contactname,
    ih.address1,
    ih.address2,
    ih.address3,
    ih.address4,
    ih.city,
    ih.regionname,
    ih.C_Location_ID,
    COALESCE(bpgt.Greeting, bpg.greeting, ih.bpgreeting) AS deliverygreeting,
    COALESCE(bp.name, ih.name)           AS deliverybpname,
    COALESCE(bp.name2, ih.name2)         AS deliverybpname2,
    COALESCE(l.address1, ih.address1)    AS deliveryadress,
    COALESCE(l.address2, ih.address2)    AS deliveryadress2,
    COALESCE(l.address3, ih.address3)    AS deliveryadress3,
    COALESCE(l.address4, ih.address4)    AS deliveryadress4,
    COALESCE(l.city, ih.city)             AS deliverycity,
    COALESCE(l.regionname, ih.regionname) AS deliveryregionname,
    COALESCE(bpl.name, ih.bp_location_name) AS locationname,
    COALESCE(l.c_location_id, ih.c_location_id) AS deliverylocation_id,
    ih.AD_Org_ID,
    ih.Org_Location_ID,
    ih.C_Invoice_ID AS record_id,
    COALESCE(
        cl.postal || cl.postal_add,
        cl.postal,
        cl.postal_add
    ) AS postal,
    COALESCE(cct.Name, cc.name) AS countryname,
    COALESCE(
        dl.postal || dl.postal_add,
        dl.postal,
        dl.postal_add
    ) AS deliverypostal,
    COALESCE(dct.Name, dc.name) AS deliverycountryname,
    org.name AS org_name,
    orgloc.address1 AS org_address1,
    orgloc.address2 AS org_address2,
    orgloc.address3 AS org_address3,
    orgloc.address4 AS org_address4,
    COALESCE(
        orgloc.postal || orgloc.postal_add,
        orgloc.postal,
        orgloc.postal_add
    ) AS org_postal,
    orgloc.city AS org_city,
    COALESCE(orgct.Name, orgcountry.name) AS org_countryname,
    orgcountry.countrycode AS org_countrycode
FROM c_invoice_header_v ih
LEFT JOIN c_order o
    ON o.c_order_id = ih.c_order_id
LEFT JOIN c_bpartner bp
    ON bp.c_bpartner_id = o.c_bpartner_id
LEFT JOIN c_greeting bpg
    ON bpg.c_greeting_id = bp.c_greeting_id
LEFT JOIN c_greeting_trl bpgt
    ON bpgt.c_greeting_id = bpg.c_greeting_id AND bpgt.AD_Language = $P{CURRENT_LANG}
LEFT JOIN c_bpartner_location bpl
    ON bpl.c_bpartner_location_id = o.c_bpartner_location_id
LEFT JOIN c_location l
    ON l.c_location_id = bpl.c_location_id
JOIN c_location cl
    ON cl.c_location_id = ih.c_location_id
JOIN c_country cc
    ON cc.c_country_id = cl.c_country_id
LEFT JOIN c_country_trl cct
    ON cct.c_country_id = cc.c_country_id AND cct.AD_Language = $P{CURRENT_LANG}
JOIN c_location dl
    ON dl.c_location_id = COALESCE(l.c_location_id, ih.c_location_id)
JOIN c_country dc
    ON dc.c_country_id = dl.c_country_id
LEFT JOIN c_country_trl dct
    ON dct.c_country_id = dc.c_country_id AND dct.AD_Language = $P{CURRENT_LANG}
JOIN AD_Org org
    ON org.AD_Org_ID = ih.AD_Org_ID
JOIN c_location orgloc
    ON orgloc.c_location_id = ih.org_location_id
JOIN c_country orgcountry
    ON orgcountry.c_country_id = orgloc.c_country_id
LEFT JOIN c_country_trl orgct
    ON orgct.c_country_id = orgcountry.c_country_id AND orgct.AD_Language = $P{CURRENT_LANG}
WHERE
    ih.c_invoice_id = $P{RECORD_ID}]]>
	</queryString>
