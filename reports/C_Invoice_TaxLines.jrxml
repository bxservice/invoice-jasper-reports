	<queryString language="SQL">
		<![CDATA[SELECT
    ilt.line,
    ilt.linenetamt,
    ilt.qtyinvoiced,
    ilt.qtyentered,
    ilt.uomsymbol,
    ilt.c_uom_name,
    ilt.name AS p_name,
    ilt.description,
    ilt.documentnote,
    ilt.productvalue,
    ilt.priceentered,
    ilt.priceactual,
    ilt.productdescription,
    ilt.c_tax_id,
    ilt.c_invoice_id AS record_id,
    COALESCE(taxtr.description, c_tax.description, ilt.name) AS name
FROM c_invoice_linetax_v ilt
JOIN c_tax
    ON c_tax.c_tax_id = ilt.c_tax_id
LEFT JOIN C_Tax_Trl taxtr
    ON taxtr.C_Tax_ID = c_tax.C_Tax_ID AND taxtr.AD_Language = $P{CURRENT_LANG}
WHERE ilt.c_invoice_id = $P{RECORD_ID}
  AND (ilt.line > 999000 OR ilt.line IS NULL)
ORDER BY ilt.line]]>
	</queryString>
